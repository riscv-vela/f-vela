diff --git a/src/ggml-bitnet-mad.cpp b/src/ggml-bitnet-mad.cpp
index eeca82b..7b3af7e 100644
--- a/src/ggml-bitnet-mad.cpp
+++ b/src/ggml-bitnet-mad.cpp
@@ -359,5 +359,24 @@ void ggml_vec_dot_i2_i8_s(int n, float * s, size_t bs, const void * vx, size_t b
     int sumi = vaddlvq_s32(accu_0);
     *s = (float)sumi;
 
+#else
+    // Portable scalar path (RISC-V / Rocket core). Same block layout as the AVX2 kernel:
+    // every 128 weights are 32 bytes, byte p holds weights p, 32+p, 64+p, 96+p at bit
+    // shifts 6, 4, 2, 0. Codes are 0/1/2 (= w + 1); the caller subtracts act_sums.
+    (void) bs; (void) bx; (void) by; (void) nrc;
+    (void) group32_num; (void) la_num; (void) groupla_num;
+    int32_t sumi = 0;
+    for (int b = 0; b < nb; b++) {
+        const uint8_t * xb = x + b * 32;
+        const int8_t  * yb = y + b * 128;
+        for (int p = 0; p < 32; p++) {
+            const int q = xb[p];
+            sumi += ((q >> 6) & 3) * yb[p]
+                  + ((q >> 4) & 3) * yb[32 + p]
+                  + ((q >> 2) & 3) * yb[64 + p]
+                  + ( q       & 3) * yb[96 + p];
+        }
+    }
+    *s = (float)sumi;
 #endif
