diff --git a/ggml/src/CMakeLists.txt b/ggml/src/CMakeLists.txt
index 500dfbd4..6ab7359a 100644
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ -1380,3 +1380,19 @@ if (BUILD_SHARED_LIBS)
     set_target_properties(ggml PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(ggml PRIVATE GGML_SHARED GGML_BUILD)
 endif()
+
+# velaNPU offload (software/test/bitnet_test/vela): -DGGML_VELA=ON -DGGML_VELA_DIR=<dir with ggml-vela.c>
+#   GGML_VELA_EMULATE=ON  -> host build, Gemmini calls are emulated in C (checks layouts on x86)
+#   GGML_VELA_GEMMINI_INC -> directory with gemmini.h / gemmini_fp16.h (RISC-V build)
+option(GGML_VELA         "ggml: offload matmuls to velaNPU (Gemmini)" OFF)
+option(GGML_VELA_EMULATE "ggml: emulate velaNPU in software"          OFF)
+if (GGML_VELA)
+    target_sources(ggml PRIVATE ${GGML_VELA_DIR}/ggml-vela.c ${GGML_VELA_DIR}/vela_npu.c ${GGML_VELA_DIR}/vela_rope.c)
+    target_include_directories(ggml PUBLIC ${GGML_VELA_DIR})
+    target_compile_definitions(ggml PUBLIC GGML_USE_VELA)
+    if (GGML_VELA_EMULATE)
+        target_compile_definitions(ggml PRIVATE VELA_EMULATE)
+    else()
+        target_include_directories(ggml PRIVATE ${GGML_VELA_GEMMINI_INC})
+    endif()
+endif()
